<Project>
  <Sdk Name="MSTest.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <TestingPlatformShowTestsFailureDetails>true</TestingPlatformShowTestsFailureDetails>
    <NoWarn>$(NoWarn);MSTEST0032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Semantics.Strings\Semantics.Strings.csproj" />
    <ProjectReference Include="..\Semantics.Paths\Semantics.Paths.csproj" />
    <ProjectReference Include="..\Semantics.Quantities\Semantics.Quantities.csproj" />
    <ProjectReference Include="..\Semantics.Music\Semantics.Music.csproj" />
    <ProjectReference Include="..\Semantics.Color\Semantics.Color.csproj" />
    <ProjectReference Include="..\Semantics.Strings.Identifiers\Semantics.Strings.Identifiers.csproj" />
    <!-- Referenced as a plain library, not OutputItemType="Analyzer": SourceGeneratorTests drives
         the generators explicitly through CSharpGeneratorDriver rather than having them run against
         this project. Only the generator assembly itself is wanted here; DropBundledGeneratorDependencies
         below drops the rest. -->
    <ProjectReference Include="..\Semantics.SourceGenerators\Semantics.SourceGenerators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- The generator declares its dependencies PrivateAssets="all" so they do not flow to
         consumers, but the generators genuinely execute in these tests and fail with
         FileNotFoundException without CodeBlocker present. PropertyTemplateTests also needs its
         types at compile time. -->
    <PackageReference Include="ktsu.CodeBlocker" />
    <!-- GeneratorBase, MetadataFile and the diagnostic catalogue moved to this package; the
         generator declares it PrivateAssets="all", so the tests that touch those types directly
         and the harness that drives the generators both need it referenced here. -->
    <PackageReference Include="ktsu.SourceGeneratorToolkit" />
    <PackageReference Include="ktsu.SourceGeneratorToolkit.Testing" />
    <!-- SemanticStringJsonTests exercises the converter registration that consumers are
         expected to perform; Semantics.Strings itself no longer depends on this. -->
    <PackageReference Include="ktsu.RoundTripStringJsonConverter" />
    <!-- PreciseNumberStorageConversionTests runs the shared conversion suite over PreciseNumber,
         the storage type the Semantics.Quantities.Precise alias package binds to. Only the test
         project references it; Semantics.Quantities does not. -->
    <PackageReference Include="ktsu.PreciseNumber" />
  </ItemGroup>

  <ItemGroup>
    <!-- Drive the generators with the real production metadata rather than fixtures, so these tests
         fail if a metadata change breaks generation. -->
    <None Include="..\Semantics.SourceGenerators\Metadata\*.json"
          Link="GeneratorMetadata\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The generator bundles its dependencies alongside itself so that they are present when a
       compiler loads it as an analyzer. This project loads it as an ordinary assembly instead, so
       that bundle arrives as compile references it did not ask for, and the netstandard2.0 builds
       of System.Memory and System.Numerics.Vectors in it define types that .NET 10 has in the box:
       CS0433 on Span<T>, ReadOnlySpan<T>, Vector4. Everything the tests genuinely need from those
       packages is a PackageReference above, resolved for this project's own framework.

       So: keep the generator assembly, drop what rode along with it. Anything else resolved from
       that project is a bundled dependency by construction, since a project contributes exactly one
       assembly of its own.

       This used to be done by passing the generator AdditionalProperties="BundleAnalyzerDependencies=false",
       which asked MSBuild for a second instance of that project, built concurrently with the first
       and into the same output directory. See the comment on GetDependencyTargetPaths for the cost.
       Filtering here asks for no second instance, so it cannot recur. -->
  <Target Name="DropBundledGeneratorDependencies" AfterTargets="ResolveProjectReferences">
    <PropertyGroup>
      <!-- Matched as a full path rather than by file name, so this cannot quietly start dropping
           references from some other project that happens to share a name. -->
      <_SemanticsGeneratorProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..', 'Semantics.SourceGenerators', 'Semantics.SourceGenerators.csproj'))</_SemanticsGeneratorProject>
    </PropertyGroup>
    <ItemGroup>
      <_ResolvedProjectReferencePaths
        Remove="@(_ResolvedProjectReferencePaths)"
        Condition="'%(MSBuildSourceProjectFile)' == '$(_SemanticsGeneratorProject)' And '%(Filename)' != 'Semantics.SourceGenerators'" />
    </ItemGroup>
  </Target>

</Project>
