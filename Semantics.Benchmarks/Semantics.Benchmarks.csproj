<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- BenchmarkDotNet finds the project that produced a benchmark assembly by matching the
         assembly name against .csproj file names. ktsu.Sdk would otherwise name the output
         ktsu.Semantics.Benchmarks, which matches no project file. -->
    <AssemblyName>Semantics.Benchmarks</AssemblyName>
    <RootNamespace>ktsu.Semantics.Benchmarks</RootNamespace>
    <!-- Benchmarks are tooling: not shipped, and not something unit tests cover. Telling the
         Sonar scanner so here keeps the coverage gate off this project's back. -->
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BenchmarkDotNet.Annotations" />
    <!-- PreciseNumber is one of the storage types measured, so it is referenced here directly
         rather than picked up through Semantics.Quantities.Precise, which ships only props. -->
    <PackageReference Include="ktsu.PreciseNumber" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <!-- Normally the working copy. Set BenchmarkAgainstVersion to measure a released package
       instead, in the environment of the same `dotnet run` that names this project, as
       `BenchmarkAgainstVersion=5.2.0 dotnet run -c Release ...`. An environment variable rather
       than a `-p:` switch, because BenchmarkDotNet builds each benchmark in an autogenerated
       project of its own, which a property set on the outer run never reaches. MSBuild reads
       environment variables as properties in every project, including that one.

       That switch is how the release history is charted. No tag in this repository carries a
       benchmark project, so there is no older source to check out and run; measuring published
       packages with today's benchmarks is the better measurement anyway, because every version
       is then timed by identical code.

       It is also why nothing here touches an internal member: the InternalsVisibleTo that would
       expose one names the test assembly and not this one, and a benchmark built on internals
       could only ever measure the working copy. -->
  <ItemGroup Condition="'$(BenchmarkAgainstVersion)' == ''">
    <ProjectReference Include="..\Semantics.Quantities\Semantics.Quantities.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BenchmarkAgainstVersion)' != ''">
    <PackageReference Include="ktsu.Semantics.Quantities" VersionOverride="$(BenchmarkAgainstVersion)" />
  </ItemGroup>

</Project>
